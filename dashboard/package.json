{
  "name": "agentmesh-dashboard",
  "version": "0.1.0",
  "description": "AgentMesh live dashboard: Handoffs, Agents and Run views over the daemon's SSE stream.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
